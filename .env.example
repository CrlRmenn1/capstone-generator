# Copy to .env and adjust. No AI API key belongs here: AI mode uses each student's own key.

# Signs login sessions. If unset, a random one is generated in instance/secret.key.
SECRET_KEY=change-me-to-a-long-random-string

# Encrypts students' remembered API keys. If unset, one is generated in instance/fernet.key.
# If you change or lose it, remembered keys can't be decrypted and students must re-enter them.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FERNET_KEY=

# Defaults to SQLite in instance/capsense.db. For MySQL:
# DATABASE_URL=mysql+pymysql://user:password@localhost/capsense
